<%@ page contentType="text/html;charset=UTF-8" %><%@ include file="header.jspf" %><c:set var="pageTitle" value="Explore Feedback" />
<section class="list-page section-enter"><div class="page-title-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> THE CAMPUS CONVERSATION</div><h1>Voices that <span class="highlight-word">matter.</span></h1><p>Explore shared experiences and ideas from the student community.</p></div><a class="btn btn-primary" href="${ctx}/feedback">+ Add feedback</a></div><div class="list-metrics"><div><span>APPROVED FEEDBACK</span><strong><c:out value="${total}" default="0"/></strong></div><div><span>AVERAGE RATING</span><strong><c:out value="${average}" default="0.0"/><small>/5</small></strong></div><div><span>YOUR VOICE</span><strong>Counts<span class="metric-star">✳</span></strong></div></div>
<form class="filter-bar" method="get" action="${ctx}/feedbacks"><div class="search-box"><span>⌕</span><input type="search" name="q" value="<c:out value='${search}'/>" placeholder="Search feedback, topics or keywords..."><button type="submit" aria-label="Search">→</button></div><label class="filter-select"><span>Rating</span><select name="rating" onchange="this.form.submit()"><option value="0" ${rating == 0 ? 'selected' : ''}>All ratings</option><option value="5" ${rating == 5 ? 'selected' : ''}>★★★★★ 5 stars</option><option value="4" ${rating == 4 ? 'selected' : ''}>★★★★ 4 stars</option><option value="3" ${rating == 3 ? 'selected' : ''}>★★★ 3 stars</option><option value="2" ${rating == 2 ? 'selected' : ''}>★★ 2 stars</option><option value="1" ${rating == 1 ? 'selected' : ''}>★ 1 star</option></select></label><a class="btn btn-quiet btn-filter-reset" href="${ctx}/feedbacks">Reset</a></form>
<c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><div class="feedback-grid"><c:forEach items="${feedbacks}" var="f"><article class="feedback-card"><div class="feedback-card-top"><span class="feedback-topic"><c:out value="${f.subject}"/></span><span class="rating-badge"><span>★</span> <c:out value="${f.rating}"/>.0</span></div><div class="feedback-stars"><c:forEach begin="1" end="5" var="s"><span class="${s <= f.rating ? 'star-on' : 'star-off'}">★</span></c:forEach></div><p class="feedback-message"><c:out value="${f.message}"/></p><div class="feedback-author"><span class="author-avatar"><c:out value="${f.name.substring(0,1).toUpperCase()}"/></span><div><strong><c:out value="${f.name}"/></strong><small><c:out value="${f.createdAt}"/></small></div><span class="author-verified">✓</span></div></article></c:forEach></div><c:if test="${empty feedbacks}"><div class="empty-state"><span>✳</span><h3>No feedback found</h3><p>Try a different search or rating, or be the first to share your experience.</p><a class="btn btn-primary" href="${ctx}/feedback">Share feedback</a></div></c:if></section>
<%@ include file="footer.jspf" %>
