<%@ page contentType="text/html;charset=UTF-8" %><%@ include file="header.jspf" %><c:set var="pageTitle" value="Submit Feedback" />
<section class="form-layout section-enter"><div class="form-intro"><div class="eyebrow"><span class="eyebrow-dot"></span> YOUR VOICE MATTERS</div><h1>Tell us what<br>you <span class="highlight-word">think.</span></h1><p>Every useful change begins with an honest conversation. Share your experience so we can make campus life better for everyone.</p><div class="promise-card"><span class="promise-icon">✦</span><div><strong>Your voice creates change</strong><p>Feedback is reviewed before it appears publicly.</p></div></div><div class="form-side-note"><span>01</span><p>Be honest.<br>Be constructive.<br><strong>Be heard.</strong></p></div></div>
<div class="form-panel glass-panel"><div class="form-panel-heading"><div><span class="eyebrow">STUDENT FEEDBACK</span><h2>Share your experience</h2><p>Fields marked with * are required.</p></div><span class="panel-spark">✳</span></div>
<c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><c:if test="${param.success eq '1'}"><div class="success-banner"><span class="success-check">✓</span><div><strong>Feedback submitted!</strong><p>Thanks for helping improve campus life. Your feedback will appear after review.</p></div></div></c:if>
<form method="post" action="${ctx}/feedback" class="feedback-form" data-validate="feedback"><div class="field-row"><label class="field"><span>Full name *</span><input name="name" type="text" maxlength="100" placeholder="e.g. Kovid Gupta" required autocomplete="name"><small>How should we identify you?</small></label><label class="field"><span>Email address *</span><input name="email" type="email" maxlength="150" placeholder="you@example.com" required autocomplete="email"><small>For follow-up if needed</small></label></div><label class="field"><span>Feedback topic *</span><select name="subject" required><option value="" disabled selected>Select a topic</option><option>Teaching & Classes</option><option>Campus Facilities</option><option>Library & Labs</option><option>Events & Activities</option><option>Food & Canteen</option><option>Student Support</option><option>Other</option></select></label><fieldset class="rating-field"><legend>Your overall rating *</legend><div class="star-picker" role="radiogroup" aria-label="Rate your experience"><input type="radio" name="rating" value="1" id="star1" required><label for="star1" title="1 star">★</label><input type="radio" name="rating" value="2" id="star2"><label for="star2" title="2 stars">★</label><input type="radio" name="rating" value="3" id="star3"><label for="star3" title="3 stars">★</label><input type="radio" name="rating" value="4" id="star4"><label for="star4" title="4 stars">★</label><input type="radio" name="rating" value="5" id="star5"><label for="star5" title="5 stars">★</label><span class="rating-hint">Choose a rating</span></div></fieldset><label class="field"><span>Your comments *</span><textarea name="message" rows="5" maxlength="1500" placeholder="Tell us what went well or what you would like to improve..." required></textarea><small class="char-counter">0 / 1500 characters</small></label><button class="btn btn-primary btn-submit" type="submit"><span class="button-label">Submit feedback</span><span class="button-arrow">↗</span></button><p class="form-privacy">⌑ Your feedback is reviewed by the campus administrator before public display.</p></form></div></section>
<%@ include file="footer.jspf" %>
