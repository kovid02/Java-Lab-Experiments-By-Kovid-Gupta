<%@ page contentType="text/html;charset=UTF-8" %><%@ include file="header.jspf" %><c:set var="pageTitle" value="Admin Dashboard" />
<section class="admin-page section-enter"><div class="page-title-row"><div><div class="eyebrow"><span class="eyebrow-dot"></span> ADMIN WORKSPACE</div><h1>Feedback <span class="highlight-word">manager.</span></h1><p>Welcome, <strong><c:out value="${sessionScope.adminUser}"/></strong>. Review submissions and decide what becomes public.</p></div><form action="${ctx}/admin/logout" method="post"><button class="btn btn-quiet" type="submit">Sign out ↗</button></form></div><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><div class="admin-notice"><span>✳</span><div><strong>Keep the conversation constructive</strong><p>Approve feedback to show it on the public page. Hidden feedback stays visible only here.</p></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Student / Feedback</th><th>Rating</th><th>Status</th><th>Actions</th></tr></thead><tbody><c:forEach items="${feedbacks}" var="f"><tr><td><div class="admin-feedback-title"><strong><c:out value="${f.subject}"/></strong><small><c:out value="${f.name}"/> · <c:out value="${f.email}"/></small><p><c:out value="${f.message}"/></p><small><c:out value="${f.createdAt}"/></small></div></td><td><span class="rating-badge"><span>★</span> <c:out value="${f.rating}"/></span></td><td><span class="status-pill ${f.approved ? 'status-approved' : 'status-pending'}"><c:out value="${f.approved ? 'Approved' : 'Hidden / pending'}"/></span></td><td><div class="admin-actions"><form method="post" action="${ctx}/admin"><input type="hidden" name="id" value="${f.id}"><button class="btn btn-small btn-primary" name="action" value="approve">Approve</button><button class="btn btn-small btn-quiet" name="action" value="hide">Hide</button><button class="btn btn-small btn-danger" name="action" value="delete" data-confirm="Delete this feedback permanently?">Delete</button></form></div></td></tr></c:forEach></tbody></table><c:if test="${empty feedbacks}"><div class="empty-state"><span>✳</span><h3>All caught up</h3><p>No feedback has been submitted yet.</p></div></c:if></div></section>
<%@ include file="footer.jspf" %>
