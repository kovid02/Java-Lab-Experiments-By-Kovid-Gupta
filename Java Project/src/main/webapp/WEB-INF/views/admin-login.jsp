<%@ page contentType="text/html;charset=UTF-8" %><%@ include file="header.jspf" %><c:set var="pageTitle" value="Admin Login" />
<section class="login-layout section-enter"><div class="login-art"><div class="login-art-orb"></div><div class="eyebrow"><span class="eyebrow-dot"></span> ADMINISTRATION</div><h1>Listen closer.<br><span class="highlight-word">Lead better.</span></h1><p>A dedicated space to review student feedback, publish constructive ideas, and keep the campus conversation healthy.</p><div class="login-art-card"><span class="login-art-icon">⌘</span><div><strong>Dream Facilities Admin</strong><small>Feedback management portal</small></div><span class="lock-symbol">♧</span></div></div><div class="login-panel glass-panel"><span class="login-icon">⌘</span><div class="eyebrow">WELCOME BACK</div><h2>Admin sign in</h2><p>Enter your administrator credentials to continue.</p><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><form method="post" action="${ctx}/admin/login" class="feedback-form"><label class="field"><span>Username</span><input name="username" required maxlength="80" autocomplete="username" placeholder="Admin username"></label><label class="field"><span>Password</span><div class="password-wrap"><input id="adminPassword" name="password" type="password" required autocomplete="current-password" placeholder="Enter your password"><button type="button" class="password-toggle" aria-label="Show password">Show</button></div></label><button class="btn btn-primary btn-submit" type="submit"><span class="button-label">Sign in securely</span><span class="button-arrow">↗</span></button></form><p class="login-security">♧ Protected admin area · Session-based access</p></div></section>
